{
  "name": "smp",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "type-check": "turbo run type-check && pnpm run type-check:probe",
    "type-check:probe": "pnpm --dir scripts/probes/anthropic run type-check",
    "lint": "pnpm run lint:provider-boundary && python3 infra/scripts/reconcile-sprint1-docs.py . --check && turbo run lint && pnpm run lint:probe",
    "lint:provider-boundary": "pnpm exec eslint --no-inline-config --config eslint.provider-boundary.config.mjs apps packages scripts && pnpm exec tsx packages/connectors/src/source-boundary-cli.ts .",
    "lint:probe": "pnpm --dir scripts/probes/anthropic run lint",
    "mutation:cache:inspect": "node scripts/mutation-cache.mjs inspect",
    "mutation:cache:clear": "node scripts/mutation-cache.mjs clear",
    "mutation:benchmark:summary": "node scripts/mutation-evidence/performance.mjs",
    "test": "pnpm run test:enforcement && pnpm run test:feedback-order && pnpm run test:feedback-order:fixtures && pnpm run test:mutation-scope && pnpm run test:mutation-evidence && pnpm run test:infra && pnpm run test:probe && pnpm --filter @smp/db test && turbo run test --filter='!@smp/db' --concurrency=1",
    "test:enforcement": "node scripts/test-token-enforcement.mjs",
    "test:feedback-order": "node scripts/check-nous-feedback-order.mjs .",
    "test:feedback-order:fixtures": "node scripts/test-feedback-order.mjs",
    "test:mutation-scope": "node scripts/test-mutation-scope.mjs",
    "test:mutation-evidence": "node scripts/test-mutation-evidence.mjs && node scripts/test-chg014-representative-fixture.mjs",
    "test:infra": "python3 -B -m unittest infra.scripts.tests.test_reconcile_sprint1_docs infra.scripts.tests.test_sync_from_nous_config infra.scripts.tests.test_regenerate_sidebar infra.scripts.tests.test_nous_api_reconcile -v",
    "test:infra:integration": "python3 -B -m unittest infra.scripts.tests.test_sync_from_nous_integration -v",
    "test:probe": "./apps/web/node_modules/.bin/vitest run --root . --config scripts/probes/anthropic/vitest.config.ts",
    "test:contract": "./apps/web/node_modules/.bin/vitest run --root . --config scripts/probes/anthropic/vitest.contract.config.ts",
    "test:mutation:infra": "python3 -B infra/scripts/tests/run_reconcile_mutation_evidence.py && python3 -B infra/scripts/tests/run_api_reconcile_mutation_evidence.py",
    "test:mutation": "node scripts/mutation-scope.mjs",
    "test:mutation:core": "stryker run stryker.conf.json",
    "test:mutation:us007": "stryker run stryker.us007.conf.json",
    "test:mutation:us010": "stryker run stryker.us010.conf.json",
    "test:mutation:us012": "pnpm --filter smp-web exec tsx scripts/run-us012-mutation.ts",
    "test:mutation:us013": "pnpm --filter smp-web exec tsx scripts/run-us013-mutation.ts",
    "test:mutation:us015": "pnpm --filter smp-web exec tsx scripts/run-us015-mutation.ts",
    "test:mutation:us016": "pnpm --filter smp-web exec tsx scripts/run-us016-mutation.ts",
    "test:mutation:us017": "pnpm --filter smp-web exec tsx scripts/run-us017-mutation.ts",
    "test:mutation:us020": "pnpm --filter smp-web exec tsx scripts/run-us020-mutation.ts",
    "test:mutation:us022": "stryker run stryker.us022.conf.json",
    "test:mutation:us033": "pnpm --filter smp-web exec tsx scripts/run-us033-mutation.ts",
    "test:mutation:us042-surfaces": "pnpm --filter smp-web exec tsx scripts/run-us042-surfaces-mutation.ts",
    "test:mutation:probe": "pnpm --dir scripts/probes/anthropic run test:mutation",
    "check": "pnpm type-check && pnpm lint && pnpm test && pnpm build",
    "validate:routes": "./infra/scripts/validate-routes.sh",
    "validate:sidebar": "./infra/scripts/regenerate-sidebar.py --check",
    "check:generated-guidance": "python3 infra/scripts/reconcile-sprint1-docs.py . --check",
    "lint:tests": "node scripts/check-test-mocks.mjs . && node scripts/check-test-oracles.mjs ."
  },
  "devDependencies": {
    "@pact-foundation/pact": "17.0.1",
    "@stryker-mutator/core": "^9.0.0",
    "@stryker-mutator/vitest-runner": "^9.0.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.17.0",
    "tsx": "4.23.1",
    "turbo": "^2.3.3"
  }
}
