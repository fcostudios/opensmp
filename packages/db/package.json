{
  "name": "@smp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./pool-snapshots": "./src/pool-snapshots.ts",
    "./system-ids": "./src/system-ids.ts",
    "./testing/pglite": "./src/testing/pglite.ts",
    "./testing/postgres-container": "./src/testing/postgres-container.ts",
    "./testing/seed-auth-users": "./src/testing/seed-auth-users.ts"
  },
  "scripts": {
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:push": "drizzle-kit push",
    "db:verify": "node scripts/verify-schema.mjs",
    "db:parity": "node scripts/check-migration-parity.mjs",
    "type-check": "tsc --noEmit",
    "lint": "echo 'no lint'",
    "build": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "@neondatabase/serverless": "^0.10.4",
    "pg": "^8.13.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.30.1",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@electric-sql/pglite": "^0.5.4",
    "yaml": "^2.8.1"
  }
}
