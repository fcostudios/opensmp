{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "reporters": [
    "progress",
    "clear-text",
    "html"
  ],
  "coverageAnalysis": "perTest",
  "vitest": {
    "related": true
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "timeoutFactor": 4,
  "ignorePatterns": [
    ".turbo",
    ".vercel",
    "out",
    ".tmp",
    ".worktrees",
    "docs/screens",
    "docs/mocks"
  ],
  "mutate": [
    "packages/db/src/company-role-assignment-mutations.ts",
    "packages/domain/src/identity-access/authorization.ts",
    "packages/domain/src/alerts/evaluate.ts",
    "packages/domain/src/alerts/approval-aging.ts",
    "packages/domain/src/request-workflow/lifecycle.ts",
    "packages/db/src/pool-snapshots.ts",
    "apps/web/src/lib/auth/route-access.ts",
    "apps/web/src/lib/auth/route-guard.ts",
    "apps/web/src/modules/identity-access/authorization.ts",
    "apps/web/src/modules/identity-access/authorization-response.ts",
    "apps/web/src/modules/audit/with-audit.ts",
    "apps/web/src/modules/request-workflow/service.ts",
    "apps/web/src/modules/vendor-catalog/pool-repository.ts",
    "apps/web/src/modules/vendor-catalog/cross-org-move.ts",
    "apps/web/src/components/pools/pool-cards.tsx",
    "apps/web/src/components/pools/pool-tiles.tsx",
    "apps/worker/src/alerts/low-pool-facts.ts",
    "packages/ui/src/organisms/pool-gauge.tsx",
    "!**/*.{test,spec}.{ts,tsx}",
    "!**/*.d.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 80
  }
}
