{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "apps/web/vitest.us020.config.ts", "related": false },
  "ignorePatterns": ["docs/**", ".stryker-tmp/**", ".tmp/**"],
  "inPlace": false,
  "testFiles": [
