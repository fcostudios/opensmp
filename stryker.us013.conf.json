{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "apps/web/vitest.us013.config.ts", "related": false },
  "ignorePatterns": ["docs/**", ".stryker-tmp/**", ".tmp/**"],
  "inPlace": false,
  "testFiles": [
    "apps/web/src/modules/request-workflow/read-repository.integration.test.ts",
    "apps/web/src/modules/request-workflow/request-detail-decision-policy.test.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "json"],
  "mutate": [
    "apps/web/src/modules/request-workflow/read-repository.ts",
    "apps/web/src/modules/request-workflow/request-detail-decision-policy.ts"
  ],
  "concurrency": 1,
  "maxTestRunnerReuse": 1,
  "timeoutMS": 15000,
  "timeoutFactor": 2,
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "tempDirName": ".tmp/stryker-us013"
}
