{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "apps/web/vitest.us007.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text"
  ],
  "ignorePatterns": [
    ".tmp/**",
    ".stryker-tmp/**",
    "reports/**",
    "scripts/probes/anthropic/reports/**"
  ],
  "mutate": [
    "apps/web/src/modules/org-registry/register-backfill-transaction.ts:439:4-441:6",
    "apps/web/src/modules/vendor-catalog/credential-crypto.ts:37:0-101:1"
  ],
  "concurrency": 1,
  "timeoutMS": 60000,
  "timeoutFactor": 4,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 80
  },
  "tempDirName": ".tmp/stryker-us007"
}
