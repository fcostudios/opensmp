#!/usr/bin/env bash
# commit-msg — enforce traceability to a user story or change request.
#
# Every commit on this repo MUST reference at least one of:
#   - US-NNN  (user story)
#   - CHG-NNN (change request)
#
# This closes the workflow hole discovered by `nous_package.py drift`
# after Sprint 4-10, where several routes shipped with no US in the commit
# message and became orphans in the pipeline.
#
# Traceability-exempt commit types (readiness still runs):
#   - Merge commits       (Merge branch ..., Merge pull request ...)
#   - Revert commits      (Revert "...")
#   - Fixup/squash        (fixup! ..., squash! ...)
#   - Release tags        (chore(release): ...)
#
# Traceability escape hatch:
#   Set COMMIT_MSG_NO_US=1 before committing to bypass the work-ID check for an
#   emergency. It does not approve readiness or bypass the range/server gate.
#
# Install:
#   git config core.hooksPath .githooks
#   chmod +x .githooks/commit-msg
#
# Or run once:
#   ./infra/scripts/install-git-hooks.sh

set -euo pipefail

COMMIT_MSG_FILE="${1:-}"
if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
  # Called without arg (direct invocation); nothing to check
  exit 0
fi

MSG="$(cat "$COMMIT_MSG_FILE")"

# Traceability-only emergency bypass (leaves an audit trail via env var usage).
# Readiness still runs below.
TRACEABILITY_EXEMPT=0
if [ "${COMMIT_MSG_NO_US:-0}" = "1" ]; then
  echo "commit-msg: missing-ID traceability check bypassed via COMMIT_MSG_NO_US=1 — staged readiness still applies; expect drift detector and pipeline review" >&2
  TRACEABILITY_EXEMPT=1
fi

# Trim leading empty lines / whitespace
FIRST_LINE="$(echo "$MSG" | sed -E '/^\s*$/d' | head -n 1)"

# Skip exempt commit types
case "$FIRST_LINE" in
  "Merge "*|"Merge pull"*) TRACEABILITY_EXEMPT=1 ;;
  "Revert "*|"revert: "*) TRACEABILITY_EXEMPT=1 ;;
  "fixup! "*|"squash! "*|"amend! "*) TRACEABILITY_EXEMPT=1 ;;
  "chore(release):"*|"release: "*) TRACEABILITY_EXEMPT=1 ;;
esac

# Require at least one US-NNN or CHG-NNN anywhere in the commit message
# Case-insensitive so both `feat(chg-021):` (Conventional Commits scope) and
# `... CHG-021 ...` in the body are accepted.
if [ "$TRACEABILITY_EXEMPT" = "0" ] && ! echo "$MSG" | grep -qiE '\b(US|CHG)-[0-9]{2,}\b'; then
  cat >&2 <<'EOF'
✗ commit rejected: no US-NNN or CHG-NNN reference in commit message.

Every commit must trace back to a user story or change request so the
Nous pipeline can relate work to specs. Add a reference to the
subject or body:

  feat(sales): add activity log (US-013)
  fix(api): correct funnel stage order (CHG-012)

Exempt commit types: Merge, Revert, fixup!/squash!, chore(release).

Emergency bypass (leaves audit trail — will appear in drift detector):
  COMMIT_MSG_NO_US=1 git commit ...

Discover open stories:  cat docs/stories/SPRINT_PLAN.md
                        grep -l "backlog\|in_development" docs/stories/sprint-*/*.md
EOF
  exit 1
fi

# CHG-031: resolve the approval trust map from the repository when the operator
# has not exported it, so a routine commit does not fail with
# WR_APPROVAL_TRUST_UNAVAILABLE.
#
# Deliberately confined to this hook. Git never runs hooks in CI, so CI and the
# repository range gate keep reading ONLY the protected
# WORK_READINESS_APPROVAL_KEYS_JSON variable and still fail closed when it is
# absent (WORK_READINESS.md lines 119-126; CI provisioning stays CHG-027).
# Reading trust from a tracked file would weaken CI, because a pushed commit
# could add a public key alongside the signature it validates. Locally it grants
# nothing new: anyone who can edit that file can already export any value.
#
# Never overrides an explicit export, and never validates the contents --
# model.mjs still rejects missing, malformed, unknown or non-Ed25519 trust, so a
# corrupt file fails closed exactly as before.
if [ -z "${WORK_READINESS_APPROVAL_KEYS_JSON:-}" ]; then
  TRUST_FILE="$(git rev-parse --show-toplevel)/.work-readiness-trust.json"
  if [ -f "$TRUST_FILE" ]; then
    WORK_READINESS_APPROVAL_KEYS_JSON="$(cat "$TRUST_FILE")"
    export WORK_READINESS_APPROVAL_KEYS_JSON
  fi
fi

# Traceability handling completed. Validate the exact staged index and canonical
# Git message through the same readiness engine used by the repository range gate.
# There is intentionally no readiness-specific bypass.
node scripts/work-readiness.mjs check-staged --message-file "$COMMIT_MSG_FILE"
