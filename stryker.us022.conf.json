{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "apps/web/vitest.us022.config.ts", "related": false },
  "ignorePatterns": ["docs/**", ".stryker-tmp/**", ".tmp/**"],
  "inPlace": true,
  "testFiles": [
    "packages/domain/src/vendor-catalog/pool-math.test.ts",
    "packages/connectors/src/action-planner.test.ts",
    "packages/domain/src/alerts/evaluate.test.ts",
    "packages/ui/src/organisms/pool-gauge.test.tsx",
    "apps/web/src/components/pools/pool-cards.test.tsx",
    "apps/web/src/components/pools/pool-tiles.test.tsx",
    "apps/web/src/modules/vendor-catalog/pool-repository.integration.test.ts",
    "apps/web/src/modules/vendor-catalog/cross-org-move.integration.test.ts",
    "apps/web/src/modules/org-registry/repository.integration.test.ts",
    "apps/web/src/modules/request-workflow/service.integration.test.ts",
    "apps/worker/src/alerts/evaluate-alerts.integration.test.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "json"],
  "mutate": [
    "packages/domain/src/vendor-catalog/pool-math.ts",
    "packages/connectors/src/action-planner.ts",
    "packages/domain/src/alerts/evaluate.ts:72-85",
    "packages/domain/src/alerts/evaluate.ts:104-105",
    "packages/db/src/pool-snapshots.ts",
    "packages/ui/src/organisms/pool-gauge.tsx",
    "apps/web/src/components/pools/pool-cards.tsx",
    "apps/web/src/components/pools/pool-tiles.tsx",
    "apps/web/src/modules/vendor-catalog/pool-repository.ts",
    "apps/web/src/modules/vendor-catalog/cross-org-move.ts",
    "apps/web/src/modules/request-workflow/transition-core.ts:36-118",
    "apps/web/src/modules/request-workflow/transition-core.ts:138-140",
    "apps/web/src/modules/org-registry/repository.ts:743-791",
    "apps/worker/src/alerts/evaluate-alerts.ts:785-852",
    "apps/worker/src/alerts/low-pool-facts.ts"
  ],
  "concurrency": 1,
  "timeoutMS": 15000,
  "timeoutFactor": 2,
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "tempDirName": ".tmp/stryker-us022"
}
