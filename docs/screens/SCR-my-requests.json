        "emptyState": {
          "title": "Todavía no has pedido ninguna licencia",
          "description": "Cuando envíes una solicitud, aquí verás su estado paso a paso. Empieza con \"Solicitar licencia\".",
          "action": {
            "id": "btn_empty_new_request",
            "label": "Solicitar licencia",
            "variant": "primary",
            "navigate_to": "SCR-new-request"
          }
        }
      }
    ]
  },
  "meta": {
    "owner": "fcostudios__smp",
    "release": "R1",
    "template": "tpl.workspace-list",
    "journey": "J1"
  },
