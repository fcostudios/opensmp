          },
          {
            "period": "junio 2026",
            "company_code": "OPN",
            "company_name": "Opina",
            "status": "Conciliado",
            "opening_seats": "8",
            "total_usd": "USD 612,40",
            "generated_at": "03/07/2026"
          },
          {
            "period": "junio 2026",
            "company_code": "RAM",
            "company_name": "Right Angle Media",
            "status": "Borrador",
            "opening_seats": "21",
            "total_usd": "USD 2.087,15",
            "generated_at": "03/07/2026"
          },
          {
            "period": "mayo 2026",
            "company_code": "PPM",
            "company_name": "PPM",
            "status": "Conciliado",
            "opening_seats": "6",
            "total_usd": "USD 486,00",
            "generated_at": "03/06/2026"
          }
        ],
        "table": {
          "rowKey": "company_code",
          "initialSort": {
            "columnId": "period",
            "direction": "desc"
          },
          "row_on_click": {
            "navigate_to": "SCR-statement-detail"
          }
        },
        "row_on_click": {
          "navigate_to": "SCR-statement-detail"
        }
      },
      {
        "id": "scope_note",
        "type": "info-banner",
        "kind": "info",
        "icon": "info",
        "title": "Qué significa cada estado",
        "content": "Borrador: el cierre aún no se ejecuta o está en curso; las cifras pueden cambiar. Final: el cierre del período ya corrió y el total es definitivo. Conciliado: además, el total ya cuadró contra la factura del proveedor. Si eres finanzas de compañía, ves solo los estados de cuenta de tu compañía."
      }
    ]
  },
  "meta": {
    "owner": "fcostudios__smp",
    "release": "R1"
  }
}
