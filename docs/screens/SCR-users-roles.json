      },
      {
        "id": "modal_new_account",
        "type": "modal",
        "title": "Nueva cuenta",
        "description": "Crea una cuenta de acceso y vincúlala a una persona del directorio. La persona recibirá un correo para configurar su contraseña y su 2FA.",
        "states": [
          {
            "id": "default",
            "label": {
              "en-US": "Default",
              "es-EC": "Predeterminado"
            }
          },
          {
            "id": "submitting",
            "label": {
              "en-US": "Submitting",
              "es-EC": "Enviando"
            }
          },
          {
            "id": "success",
            "label": {
              "en-US": "Success",
              "es-EC": "Éxito"
            }
          },
          {
            "id": "error",
            "label": {
              "en-US": "Error",
              "es-EC": "Error"
            }
          }
        ],
        "fields": [
          {
            "id": "email",
            "label": "Correo",
            "component": "input-email",
            "required": true,
            "placeholder": "nombre@compania.ec"
          },
          {
            "id": "person_id",
            "label": "Persona vinculada",
            "component": "select-search",
            "required": false,
            "help": "Busca por nombre o correo en el directorio de personas."
          },
          {
            "id": "global_role",
            "label": "Rol global (opcional)",
            "component": "select",
            "required": false,
            "options": [
              {
                "value": "group_admin",
                "label": "Administrador del grupo"
              },
              {
                "value": "central_finance",
                "label": "Finanzas centrales"
              }
            ],
            "help": "Déjalo vacío si la cuenta solo tendrá roles por compañía."
          }
        ],
        "actions": [
          {
            "id": "btn_create_account",
            "label": "Crear cuenta",
            "variant": "primary",
            "trigger": "server_action:createUserAccount",
            "onSuccess": {
              "toast": "Cuenta creada. Enviamos el correo de activación.",
              "close": true,
              "refresh": true
            }
          },
          {
            "id": "btn_cancel_new_account",
            "label": "Cancelar",
            "variant": "quiet"
          }
        ]
      },
      {
        "id": "modal_reset_2fa",
        "type": "modal",
        "title": "Restablecer 2FA",
        "description": "Se invalidará el TOTP actual de la cuenta y la persona deberá configurarlo de nuevo en su próximo ingreso.",
        "states": [
          {
            "id": "default",
            "label": {
              "en-US": "Default",
              "es-EC": "Predeterminado"
            }
          },
          {
            "id": "submitting",
            "label": {
              "en-US": "Submitting",
              "es-EC": "Enviando"
            }
          },
          {
            "id": "success",
            "label": {
              "en-US": "Success",
              "es-EC": "Éxito"
            }
          },
          {
            "id": "error",
            "label": {
              "en-US": "Error",
              "es-EC": "Error"
            }
          }
        ],
        "fields": [
          {
            "id": "reset_note",
            "label": "Motivo (obligatorio)",
            "component": "textarea",
            "required": true,
            "placeholder": "Ej.: cambió de teléfono y perdió el autenticador"
          }
        ],
        "actions": [
          {
            "id": "btn_confirm_reset_2fa",
            "label": "Restablecer 2FA",
            "variant": "primary",
            "trigger": "server_action:resetTwoFactor",
            "onSuccess": {
              "toast": "2FA restablecido. Queda registrado en auditoría.",
              "close": true,
              "refresh": true
            }
          },
          {
            "id": "btn_cancel_reset_2fa",
            "label": "Cancelar",
            "variant": "quiet"
          }
        ]
      },
      {
        "id": "modal_disable_account",
        "type": "modal",
        "title": "Desactivar cuenta",
        "description": "La cuenta no podrá ingresar y sus roles por compañía dejan de aplicar. Las licencias de la persona no se tocan: si corresponde, inicia el retiro desde la ficha de la persona.",
        "states": [
          {
            "id": "default",
            "label": {
              "en-US": "Default",
              "es-EC": "Predeterminado"
            }
          },
          {
            "id": "submitting",
            "label": {
              "en-US": "Submitting",
              "es-EC": "Enviando"
            }
          },
          {
            "id": "success",
            "label": {
              "en-US": "Success",
              "es-EC": "Éxito"
            }
          },
          {
            "id": "error",
            "label": {
              "en-US": "Error",
              "es-EC": "Error"
            }
          }
        ],
        "fields": [
          {
            "id": "disable_note",
            "label": "Motivo (obligatorio)",
            "component": "textarea",
            "required": true,
            "placeholder": "Ej.: salida de la compañía el 30/06/2026"
          }
        ],
        "actions": [
          {
            "id": "btn_confirm_disable",
            "label": "Desactivar cuenta",
            "variant": "primary",
            "intent": "danger",
            "trigger": "server_action:disableUserAccount",
            "onSuccess": {
              "toast": "Cuenta desactivada. Queda registrado en auditoría.",
              "close": true,
              "refresh": true
            }
          },
          {
            "id": "btn_cancel_disable",
            "label": "Cancelar",
            "variant": "quiet"
          }
        ]
      },
      {
        "id": "modal_add_role",
        "type": "modal",
        "title": "Agregar rol por compañía",
        "description": "Otorga un rol de aprobación, finanzas o lectura sobre una compañía. La ventana de vigencia es opcional.",
        "states": [
          {
            "id": "default",
            "label": {
              "en-US": "Default",
              "es-EC": "Predeterminado"
            }
          },
          {
            "id": "submitting",
            "label": {
              "en-US": "Submitting",
              "es-EC": "Enviando"
            }
          },
          {
            "id": "success",
            "label": {
              "en-US": "Success",
              "es-EC": "Éxito"
            }
          },
          {
            "id": "error",
            "label": {
              "en-US": "Error",
              "es-EC": "Error"
            }
          }
        ],
        "fields": [
          {
            "id": "user_account_id",
            "label": "Usuario",
            "component": "select-search",
            "required": true,
            "help": "Busca por correo de la cuenta."
          },
          {
            "id": "company_id",
            "label": "Compañía",
            "component": "select",
            "required": true,
            "options": [
              "Kickoff",
              "Opina",
              "Right Angle Media",
              "PPM",
              "Focus"
            ]
          },
          {
            "id": "role",
            "label": "Rol",
            "component": "select",
            "required": true,
            "options": [
              {
                "value": "approver",
                "label": "Aprobador/a"
              },
              {
                "value": "finance",
                "label": "Finanzas"
              },
              {
                "value": "viewer",
                "label": "Lectura"
              }
            ]
          },
          {
            "id": "valid_from",
            "label": "Vigente desde (opcional)",
            "component": "date",
            "required": false
          },
          {
            "id": "valid_to",
            "label": "Vigente hasta (opcional)",
            "component": "date",
            "required": false,
            "help": "Ventana de delegación temporal: pendiente (R2). Por ahora define solo la vigencia del rol."
          }
        ],
        "actions": [
          {
            "id": "btn_confirm_add_role",
            "label": "Agregar rol",
            "variant": "primary",
            "trigger": "server_action:addCompanyRole",
            "onSuccess": {
              "toast": "Rol agregado.",
              "close": true,
              "refresh": true
            }
          },
          {
            "id": "btn_cancel_add_role",
            "label": "Cancelar",
            "variant": "quiet"
          }
        ]
      },
      {
        "id": "modal_remove_role",
        "type": "modal",
        "title": "Quitar rol",
        "description": "El usuario dejará de ver y operar esa compañía con este rol. La acción queda registrada en auditoría.",
        "states": [
          {
            "id": "default",
            "label": {
              "en-US": "Default",
              "es-EC": "Predeterminado"
            }
          },
          {
            "id": "submitting",
