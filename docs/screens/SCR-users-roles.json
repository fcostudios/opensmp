              "en-US": "Submitting",
              "es-EC": "Enviando"
            }
          },
          {
            "id": "success",
            "label": {
              "en-US": "Success",
              "es-EC": "Éxito"
            }
          },
          {
            "id": "error",
            "label": {
              "en-US": "Error",
              "es-EC": "Error"
            }
          }
        ],
        "fields": [
          {
            "id": "remove_note",
            "label": "Motivo (obligatorio)",
            "component": "textarea",
            "required": true,
            "placeholder": "Ej.: fin del encargo de aprobación en Opina"
          }
        ],
        "actions": [
          {
            "id": "btn_confirm_remove_role",
            "label": "Quitar rol",
            "variant": "primary",
            "intent": "danger",
            "trigger": "server_action:removeCompanyRole",
            "onSuccess": {
              "toast": "Rol quitado.",
              "close": true,
              "refresh": true
            }
          },
          {
            "id": "btn_cancel_remove_role",
            "label": "Cancelar",
            "variant": "quiet"
          }
        ]
      }
    ]
  },
