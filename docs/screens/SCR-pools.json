          }
        ]
      },
      {
        "id": "modal_register_purchase",
        "type": "modal",
        "title": "Registrar compra de licencias",
        "description": "Registra la compra hecha en la consola del proveedor conforme al runbook: crea una fila de capacidad (VendorAccountCapacity) con la cantidad y la fecha efectiva.",
        "states": [
          {
            "id": "default",
            "label": {
              "en-US": "Default",
              "es-EC": "Predeterminado"
            }
          },
          {
            "id": "submitting",
            "label": {
              "en-US": "Submitting",
              "es-EC": "Enviando"
            }
          },
          {
            "id": "success",
            "label": {
              "en-US": "Success",
              "es-EC": "Éxito"
            }
          },
          {
            "id": "error",
            "label": {
              "en-US": "Error",
              "es-EC": "Error"
            }
          }
        ],
        "fields": [
          {
            "id": "vendor_account_id",
            "label": "Organización",
            "component": "select",
            "required": true,
            "options": [
              "Org central Claude Enterprise",
              "Claude Enterprise — Kickoff (org propia)",
              "Claude Enterprise — Opina (org propia)"
            ]
          },
          {
            "id": "license_type_id",
            "label": "Tipo de licencia",
            "type": "select",
            "required": true,
            "options": [
              "Claude Enterprise — licencia estándar",
              "Claude Enterprise — licencia con API"
            ]
          },
          {
            "id": "purchased_qty",
            "label": "Cantidad comprada",
            "component": "number",
            "required": true,
            "min": 1,
            "help": "Cantidad total de licencias compradas que quedan vigentes desde la fecha efectiva."
          },
          {
            "id": "effective_from",
            "label": "Vigente desde",
            "component": "date",
            "required": true,
            "help": "Formato dd/mm/aaaa. El prorrateo se calcula por días reales (actual/actual)."
          },
          {
            "id": "note",
            "label": "Nota (opcional)",
            "component": "textarea",
            "placeholder": "Ej.: compra de 5 licencias por bloqueo de solicitud, orden interna 2026-114"
          }
        ],
        "submit": {
          "id": "btn_save_purchase",
          "label": "Guardar compra",
          "action": "server_action:registerPurchase",
          "client_request_id": true
        }
      }
    ]
  },
