            }
          }
        ]
      },
      {
        "id": "purchase_or_reclaim_callout",
        "type": "info-banner",
        "kind": "attention",
        "title": "Hay 1 solicitud bloqueada sin licencia disponible",
        "content": "La solicitud de Daniela Espinosa (Opina) está en \"Bloqueada: sin licencia disponible\" en Org central Claude Enterprise. Puedes liberar una licencia inactiva de la tabla de candidatas o registrar una compra nueva. Nota de prorrateo: una licencia comprada hoy se cobra por días reales del ciclo (prorrateo actual/actual), aprox. USD 9,03 por los 10 días restantes de julio frente a USD 27,10 por mes completo.",
        "visibleWhen": "exists(LicenseRequest.state == 'blocked_no_seat')",
        "actions": [
          {
            "id": "btn_propose_reclamation",
            "label": "Proponer reclamación",
            "variant": "secondary",
            "navigate_to": "SCR-reclamation-proposals"
          },
          {
            "id": "btn_register_purchase",
            "label": "Registrar compra",
            "variant": "primary",
            "opens_modal": "modal_register_purchase"
          }
        ]
      },
      {
        "id": "inactive_candidates",
        "type": "data-table",
        "title": "Candidatas a reclamación (inactivas)",
        "description": "Personas con licencia activa en la organización con cupo agotado y sin uso reciente. Ninguna se retira sin la aprobación de su aprobador/a.",
        "table": {
          "columns": [
            {
              "id": "person",
              "header": "Persona"
            },
            {
              "id": "company",
              "header": "Compañía"
            },
            {
              "id": "last_active",
              "header": "Última actividad"
            },
            {
              "id": "inactive_days",
              "header": "Días inactiva"
            },
            {
              "id": "status",
              "header": "Estado",
              "type": "badge"
            },
            {
              "id": "monthly_cost",
              "header": "Costo mensual",
              "align": "right",
              "type": "money"
            }
          ],
          "row_on_click": {
            "navigate_to": "SCR-person-detail"
          }
        },
        "rows": [
          {
