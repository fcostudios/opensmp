        "metricCards": {
          "dataFreshness": {
            "label": "datos al 19-jul (retraso ~3 días del proveedor)"
          },
          "cards": [
            {
              "id": "tile_licencias_activas",
              "label": "Licencias activas",
              "valueExpr": "7",
              "caption": "asignaciones abiertas hoy"
            },
            {
              "id": "tile_costo_mensual",
              "label": "Costo mensual actual",
              "valueExpr": "USD 1.049,30",
              "caption": "run-rate según tarifas vigentes · datos al 19-jul"
            },
            {
              "id": "tile_presupuesto",
              "label": "Presupuesto mensual",
              "valueExpr": "USD 1.500,00",
              "caption": "run-rate USD 1.049,30 de USD 1.500,00 (70 %)",
              "progressBar": {
                "valueExpr": "1049.30",
                "maxExpr": "1500.00",
                "label": "Run-rate frente al presupuesto"
              }
            },
            {
              "id": "tile_personas",
              "label": "Personas",
              "valueExpr": "12",
              "caption": "11 activas · 1 salió del grupo"
            }
          ]
        },
        "cards": [
          {
            "id": "tile_licencias_activas",
            "title": "Licencias activas",
            "value": "7"
          },
          {
            "id": "tile_costo_mensual",
            "title": "Costo mensual actual",
            "value": "USD 1.049,30"
          },
          {
            "id": "tile_presupuesto",
            "title": "Presupuesto mensual",
            "value": "USD 1.500,00"
          },
          {
            "id": "tile_personas",
            "title": "Personas",
            "value": "12"
          }
        ]
      },
