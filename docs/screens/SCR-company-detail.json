{
  "id": "SCR-company-detail",
  "title": "Kickoff · KCK",
  "description": "Company record (tpl.workspace-record, Module A): stat tiles for active licenses, current monthly cost (RateCard-derived run-rate), budget vs run-rate and people count; count tabs for Personas, Roles (CompanyRoleAssignment add/remove), Licencias (open LicenseAssignment rows), Estados de cuenta (recent Statement list) and Configuración (Company settings). Sample record: Kickoff (KCK).",
  "route": "/companias/:companyId",
  "roles": [
    "group_admin",
    "approver",
    "company_finance",
    "viewer"
  ],
  "i18n": {
    "es-EC": {
      "title": "Kickoff · KCK",
      "subtitle": "Interna · 12 personas · contacto de finanzas: finanzas@kickoff.ec · creada 05/03/2026"
    }
  },
  "meta": {
    "owner": "fcostudios__smp",
    "release": "R1"
  },
  "accessibility": {
    "lang": "es-EC",
    "ariaLandmarks": true
  },
  "breadcrumbs": [
    {
      "label": "Compañías",
      "route": "/companias"
    },
    {
      "label": "Kickoff · KCK"
    }
  ],
  "layout": {
