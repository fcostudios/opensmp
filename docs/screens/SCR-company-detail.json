          {
            "id": "form_configuracion",
            "type": "form",
            "title": "Configuración de la compañía",
            "description": "Company settings: presupuesto mensual, contacto de finanzas, idioma del estado de cuenta y estado. Los cambios quedan en el registro de auditoría.",
            "visibleWhen": "activeTab == 'tab_configuracion'",
            "states": [
              {
                "id": "default",
                "label": {
                  "en-US": "Default",
                  "es-EC": "Predeterminado"
                }
              },
              {
                "id": "submitting",
                "label": {
                  "en-US": "Submitting",
                  "es-EC": "Enviando"
                }
              },
              {
                "id": "success",
                "label": {
                  "en-US": "Success",
                  "es-EC": "Éxito"
                }
              },
              {
                "id": "error",
                "label": {
                  "en-US": "Error",
                  "es-EC": "Error"
                }
              }
            ],
            "fields": [
              {
                "id": "budget_monthly_usd",
                "label": "Presupuesto mensual (USD)",
                "component": "input-money",
                "default": "1.500,00",
                "help": "Si el run-rate supera este monto, verás una alerta en el panel."
              },
              {
                "id": "finance_contact_email",
                "label": "Contacto de finanzas (correo)",
                "component": "input-email",
                "default": "finanzas@kickoff.ec"
              },
              {
                "id": "statement_language",
                "label": "Idioma del estado de cuenta",
                "component": "select",
                "default": "es",
                "options": [
                  {
                    "value": "es",
                    "label": "Español (es-EC)"
                  },
                  {
                    "value": "en",
                    "label": "Inglés (en-US)"
                  }
                ]
              },
              {
                "id": "status",
                "label": "Estado de la compañía",
                "component": "select",
                "default": "active",
                "options": [
                  {
                    "value": "active",
                    "label": "Activa"
                  },
                  {
                    "value": "inactive",
                    "label": "Inactiva"
                  }
                ]
              }
            ],
            "submit": {
              "id": "btn_guardar_configuracion",
              "label": "Guardar cambios",
              "action": "server_action:updateCompany",
              "client_request_id": true
            }
          }
        ]
      },
      {
        "id": "modal_add_role",
        "type": "modal",
        "title": "Agregar rol en Kickoff",
        "description": "Crea un CompanyRoleAssignment: usuario + rol + ventana de vigencia. Un mismo usuario no puede repetir el mismo rol en la misma compañía.",
        "states": [
          {
            "id": "default",
            "label": {
              "en-US": "Default",
              "es-EC": "Predeterminado"
            }
          },
          {
            "id": "submitting",
            "label": {
              "en-US": "Submitting",
              "es-EC": "Enviando"
            }
          },
          {
            "id": "success",
            "label": {
              "en-US": "Success",
              "es-EC": "Éxito"
            }
          },
          {
            "id": "error",
            "label": {
              "en-US": "Error",
              "es-EC": "Error"
            }
          }
        ],
        "fields": [
          {
            "id": "user_account_id",
            "label": "Usuario",
            "component": "select",
            "required": true,
            "placeholder": "Busca por nombre o correo",
            "options": [
              "María Fernanda Ríos · mrios@kickoff.ec",
              "Paola Cárdenas · pcardenas@kickoff.ec",
              "Verónica Espín · vespin@corporativo.ec"
            ]
          },
          {
            "id": "role",
            "label": "Rol",
            "component": "select",
            "required": true,
            "options": [
              {
                "value": "approver",
                "label": "Aprobador/a"
              },
              {
                "value": "finance",
                "label": "Finanzas"
              },
              {
                "value": "viewer",
                "label": "Visualización"
              }
            ]
          },
          {
            "id": "valid_from",
            "label": "Vigente desde (opcional)",
            "component": "date-picker",
            "placeholder": "dd/mm/aaaa"
          },
          {
            "id": "valid_to",
            "label": "Vigente hasta (opcional)",
            "component": "date-picker",
            "placeholder": "dd/mm/aaaa",
            "help": "Déjalo vacío si el rol no tiene fecha de fin."
          }
        ],
        "submit": {
          "id": "btn_guardar_rol",
          "label": "Guardar rol",
          "action": "server_action:addCompanyRole",
          "client_request_id": true
        },
        "roles": [
          "group_admin"
        ]
      }
