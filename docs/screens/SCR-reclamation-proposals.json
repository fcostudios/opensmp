        "emptyState": {
          "icon": "check-circle",
          "title": "No hay propuestas pendientes",
          "description": "Te avisaremos por correo cuando detectemos licencias sin uso en tu compañía."
        }
      },
      {
        "id": "modal_liberar",
        "type": "modal",
        "title": "Liberar licencia",
        "description": "Confirmación de reclamación con consentimiento explícito: nunca se retira una licencia en silencio.",
        "states": [
          {
            "id": "default",
            "label": {
              "en-US": "Default",
              "es-EC": "Predeterminado"
            }
          },
          {
            "id": "submitting",
            "label": {
              "en-US": "Submitting",
              "es-EC": "Enviando"
            }
          },
          {
            "id": "success",
            "label": {
              "en-US": "Success",
              "es-EC": "Éxito"
            }
          },
          {
            "id": "error",
            "label": {
              "en-US": "Error",
              "es-EC": "Error"
            }
          }
        ],
        "content": "{persona} no usa su licencia desde el {fecha} ({n} días). ¿Quieres liberarla para el cupo del grupo? No se retirará sin tu aprobación.",
        "fields": [
          {
            "id": "release_note",
            "label": "Nota (opcional)",
            "component": "textarea",
            "placeholder": "Ej.: confirmado con la persona, ya no usa la herramienta",
            "required": false
          }
        ],
        "actions": [
          {
            "id": "btn_confirm_liberar",
            "label": "Sí, liberar licencia",
            "variant": "primary",
            "intent": "server_action:approveReclamation",
            "onSuccess": {
              "toast": "Listo. La licencia entra en retiro y volverá al cupo del grupo.",
              "close": true,
              "refresh": true
            },
            "onError": {
              "toast": "No pudimos registrar la liberación. Intenta de nuevo."
            }
          },
          {
            "id": "btn_cancel_liberar",
            "label": "Cancelar",
            "variant": "secondary",
            "intent": "close_modal"
          }
        ]
      },
      {
        "id": "modal_mantener",
        "type": "modal",
        "title": "Mantener licencia",
        "description": "Descarta la propuesta con una nota obligatoria; la decisión queda en el registro de auditoría.",
        "states": [
          {
            "id": "default",
            "label": {
              "en-US": "Default",
              "es-EC": "Predeterminado"
            }
          },
          {
            "id": "submitting",
            "label": {
              "en-US": "Submitting",
              "es-EC": "Enviando"
            }
          },
          {
            "id": "success",
            "label": {
              "en-US": "Success",
              "es-EC": "Éxito"
            }
          },
          {
            "id": "error",
            "label": {
              "en-US": "Error",
              "es-EC": "Error"
            }
          }
        ],
        "content": "Vas a mantener esta licencia aunque aparece sin uso. Cuéntanos por qué — la nota queda registrada.",
        "fields": [
          {
            "id": "keep_note",
            "label": "¿Por qué la mantienes?",
            "component": "textarea",
            "placeholder": "Ej.: la persona vuelve de licencia médica el próximo mes",
            "required": true,
            "validation": [
              {
                "type": "required",
                "message": "Necesitamos una nota para mantener la licencia."
              }
            ]
          }
        ],
        "actions": [
          {
            "id": "btn_confirm_mantener",
            "label": "Mantener licencia",
            "variant": "primary",
            "intent": "server_action:dismissReclamation",
            "onSuccess": {
              "toast": "Propuesta descartada. La nota quedó en el registro.",
              "close": true,
              "refresh": true
            },
            "onError": {
              "toast": "No pudimos guardar la nota. Intenta de nuevo."
            }
          },
          {
            "id": "btn_cancel_mantener",
            "label": "Cancelar",
            "variant": "secondary",
            "intent": "close_modal"
          }
        ]
      }
    ]
  },
  "meta": {
    "owner": "fcostudios__smp",
    "release": "R1"
  },
  "roles": [
    "approver",
    "group_admin"
  ],
  "route": "/reclamaciones",
  "title": "Propuestas de reclamación"
}