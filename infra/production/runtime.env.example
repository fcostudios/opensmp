# Store the completed file outside Git, mode 0600. Values are runtime inputs.
# Public domains have no scheme/port. Local rehearsal uses *.localhost.
APP_DOMAIN=
AUTH_DOMAIN=
ACME_EMAIL=
APP_IMAGE=ledger-app:release
WORKER_IMAGE=ledger-worker:release
MIGRATION_IMAGE=ledger-migrations:release
POSTGRES_SUPERUSER_PASSWORD=
LEDGER_OWNER_PASSWORD=
LEDGER_APP_PASSWORD=
LEDGER_BACKUP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_SECRET=
NEXTAUTH_SECRET=
# Base64-encoded 32-byte KEK file, readable by container UID 1001, mode 0400/0440.
LEDGER_KEK_FILE=
# e.g. smtp.example.com:587; no development mail sink in production.
SMTP_RELAYHOST=
SMTP_RELAYHOST_USERNAME=
SMTP_RELAYHOST_PASSWORD=
SMTP_SENDER_DOMAINS=
# Maintained mainland Ecuador holidays, comma-separated ISO dates.
ECUADOR_HOLIDAYS=
# Public age recipient; escrow its distinct private key off-host (US-048).
BACKUP_AGE_RECIPIENT=
