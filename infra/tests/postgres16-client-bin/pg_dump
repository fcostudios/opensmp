#!/usr/bin/env bash
# The test fixture is a real postgres:16-alpine container. These tiny adapters
# ensure the real, version-matched PostgreSQL client runs inside that fixture.
set -euo pipefail
: "${BACKUP_TEST_POSTGRES_CONTAINER:?fixture container is required}"
# shellcheck source=infra/tests/postgres16-client-bin/uri-port.sh
source "$(dirname "${BASH_SOURCE[0]}")/uri-port.sh"
if [[ "${BACKUP_TEST_DELAY_PG_DUMP:-0}" != '0' ]]; then
  sleep "$BACKUP_TEST_DELAY_PG_DUMP"
fi
args=()
for arg in "$@"; do
  args+=("$(map_fixture_dbname_arg "${BACKUP_TEST_POSTGRES_HOST_PORT:?fixture host port is required}" "$arg")")
done
exec docker exec \
  --env PGHOST --env PGPORT --env PGDATABASE --env PGUSER --env PGPASSWORD \
  "$BACKUP_TEST_POSTGRES_CONTAINER" pg_dump "${args[@]}"
