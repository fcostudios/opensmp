#!/usr/bin/env bash
# Test-only DNS/endpoint-switch seam. The admin path delegates to the real
# PostgreSQL 16 fixture adapter; the first random staging connection is sent to
# a distinct real PostgreSQL cluster so the in-session identity guard is tested.
set -euo pipefail

real_psql="${RESTORE_TEST_REAL_PSQL:-$(dirname "$0")/../postgres16-client-bin/psql}"

if [[ "${BACKUP_TEST_SWITCH_SYSTEM_IDENTIFIER:-}" == 1 ]]; then
  is_system_identifier_query=0
  for arg in "$@"; do
    [[ "$arg" == *'pg_control_system'* ]] && is_system_identifier_query=1
  done
  if [[ "$is_system_identifier_query" == 1 ]]; then
    : "${BACKUP_TEST_SYSTEM_ID_COUNTER:?system identifier counter is required}"
    : "${BACKUP_TEST_SWITCH_CONTAINER:?switch container is required}"
    query_count=0
    [[ ! -f "$BACKUP_TEST_SYSTEM_ID_COUNTER" ]] || query_count="$(< "$BACKUP_TEST_SYSTEM_ID_COUNTER")"
    query_count=$((query_count + 1))
    printf '%s\n' "$query_count" > "$BACKUP_TEST_SYSTEM_ID_COUNTER"
    if [[ "$query_count" -ge 2 ]]; then
      switched_args=()
      for arg in "$@"; do
        if [[ "$arg" == --port=* ]]; then
          switched_args+=(--port=5432)
        else
          switched_args+=("$arg")
        fi
      done
      exec docker exec -i \
        --env PGHOST --env PGDATABASE --env PGUSER --env PGPASSWORD --env PGPORT=5432 \
        "$BACKUP_TEST_SWITCH_CONTAINER" psql "${switched_args[@]}"
    fi
  fi
fi

if [[ "${RESTORE_TEST_SWITCH_TARGET_SESSION:-}" != 1 ]]; then
  exec "$real_psql" "$@"
fi

staging_database=''
for arg in "$@"; do
  if [[ "$arg" =~ ^--dbname=(ledger_restore_stage_[a-f0-9]{32})$ ]]; then
    staging_database="${BASH_REMATCH[1]}"
    break
  fi
done

if [[ -z "$staging_database" ]]; then
  exec "$real_psql" "$@"
fi

: "${RESTORE_TEST_SWITCH_CONTAINER:?switch container is required}"
: "${RESTORE_TEST_SWITCH_LOG:?switch log is required}"
docker exec "$RESTORE_TEST_SWITCH_CONTAINER" psql --username postgres --dbname postgres --set ON_ERROR_STOP=1 \
  --command "CREATE DATABASE \"$staging_database\" WITH TEMPLATE template0 OWNER \"${PGUSER:?restore admin user is required}\""
printf 'name=%s\n' "$staging_database" > "$RESTORE_TEST_SWITCH_LOG"

switched_args=()
for arg in "$@"; do
  if [[ "$arg" == --port=* ]]; then
    switched_args+=(--port=5432)
  else
    switched_args+=("$arg")
  fi
done
exec docker exec -i \
  --env PGHOST --env PGDATABASE --env PGUSER --env PGPASSWORD \
  --env PGPORT=5432 \
  "$RESTORE_TEST_SWITCH_CONTAINER" psql "${switched_args[@]}"
