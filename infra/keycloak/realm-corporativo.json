{
  "id": "corporativo",
  "realm": "corporativo",
  "displayName": "Ledger",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "UPDATE_TOTP",
    "UPDATE_TOTP_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Technical role that activates mandatory Keycloak OTP"
      }
    ]
  },
  "groups": [
    {
      "name": "platform-admin",
      "path": "/platform-admin",
      "realmRoles": [
        "platform-admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "smp-web",
      "name": "Ledger web application",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SMP_WEB_CLIENT_SECRET}",
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "rootUrl": "${LEDGER_PUBLIC_URL:http://localhost:3000}",
      "baseUrl": "${LEDGER_PUBLIC_URL:http://localhost:3000}",
      "redirectUris": [
        "${LEDGER_PUBLIC_URL:http://localhost:3000}/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "${LEDGER_PUBLIC_URL:http://localhost:3000}"
      ],
      "defaultClientScopes": [
        "profile",
        "email"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${LEDGER_PUBLIC_URL:http://localhost:3000}/*"
      }
    },
    {
      "clientId": "smp-keycloak-admin",
      "name": "Ledger identity administration service",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SMP_KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "service-account-smp-keycloak-admin",
      "enabled": true,
      "serviceAccountClientId": "smp-keycloak-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "query-groups",
          "view-events",
          "view-users"
        ]
      }
    }
  ],
  "browserFlow": "ledger-browser",
  "authenticationFlows": [
    {
      "alias": "ledger-browser",
      "description": "Browser authorization-code login for Ledger",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-spnego",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "ledger-browser-forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "ledger-browser-forms",
      "description": "Password plus conditional administrator OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "ledger-platform-admin-otp",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "ledger-platform-admin-otp",
      "description": "Require OTP only for the technical platform-admin role",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "platform-admin-role-condition",
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": true
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "platform-admin-role-condition",
      "config": {
        "condUserRole": "platform-admin"
      }
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    }
  ]
}
