{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "reporters": ["clear-text"],
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "apps/web/vitest.alert-outbox.config.ts",
    "related": false
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "timeoutFactor": 4,
  "ignorePatterns": ["docs/**", ".tmp/**"],
  "mutate": [
    "packages/notifications/src/outbox.ts:56-113",
    "packages/notifications/src/outbox.ts:119-136",
    "packages/notifications/src/outbox.ts:140-153",
    "packages/notifications/src/outbox.ts:157-192"
  ],
  "testFiles": [
    "apps/web/src/modules/alerts/repository.integration.test.ts",
    "apps/worker/src/alerts/evaluate-alerts.integration.test.ts",
    "apps/worker/src/alerts/report-job-failure.integration.test.ts"
  ],
  "thresholds": { "high": 100, "low": 100, "break": 100 }
}
