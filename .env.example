# Ledger — Environment Variables
# Copy to .env and adjust values

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/app
DATABASE_USER=app
DATABASE_PASSWORD=app

# Keycloak
KEYCLOAK_ISSUER=http://localhost:8180/realms/corporativo
KEYCLOAK_CLIENT_ID=app-api
KEYCLOAK_CLIENT_SECRET=app-api-secret-change-me

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=corporativo
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=app-web

# Redis (optional for MVP)
REDIS_URL=redis://localhost:6379

# AI (Claude API)
ANTHROPIC_API_KEY=sk-ant-CHANGE-ME

# Object Storage (Cloudflare R2)
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY=CHANGE-ME
S3_SECRET_KEY=CHANGE-ME
S3_BUCKET=app-evidence
