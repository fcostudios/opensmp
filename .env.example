# Ledger — Docker Compose runtime variables
# Copy to .env and replace every development-only value before deployment.
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
LEDGER_OWNER_PASSWORD=change-me-owner
LEDGER_APP_PASSWORD=change-me-app
LEDGER_BACKUP_PASSWORD=change-me-backup
# Public age recipient for nightly backups. Replace with the escrowed key.
BACKUP_AGE_RECIPIENT=age1nd0reflv5a7zqcpnufeqjf22klng0fkjm7cys93ay7me8ffyj4nsj32sn9
# Backup profile only: keep these host paths out of committed env files.
# run-cron.sh exports BACKUP_UID and BACKUP_GID from the invoking Linux user.
# For a manual backup invocation, export BACKUP_UID="$(id -u)" and
# BACKUP_GID="$(id -g)" along with both paths before loading
# infra/docker-compose.backup.yml.
# BACKUP_SIGNING_KEY_FILE=/srv/ledger/secrets/backup-signing.key
# BACKUP_OUTPUT_DIR=/srv/ledger/backups
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_CLIENT_SECRET=local-dev-smp-web-secret
KEYCLOAK_ADMIN_CLIENT_SECRET=local-dev-smp-keycloak-admin-secret
KEYCLOAK_PUBLIC_HOST=keycloak.localhost
KEYCLOAK_PUBLIC_PORT=8180
KEYCLOAK_PUBLIC_ORIGIN=http://keycloak.localhost:8180
LEDGER_PUBLIC_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-with-a-long-random-value
# Host paths only; create these operator-owned files outside the repository.
# The credential manifest contains environment-variable names, never key values.
LEDGER_CREDENTIAL_MANIFEST_SOURCE=/srv/ledger/secrets/go-live-credential-manifest.json
# The KEK file contains one base64-encoded 32-byte key and must be mode 0400/0440.
LEDGER_CREDENTIAL_KEK_SOURCE=/srv/ledger/secrets/integration-credential.kek
# Required operational calendar for the US-046 close-precheck. Maintain the
# mainland-Ecuador public holidays for the deployed year as comma-separated ISO dates.
# The worker fails closed if this is blank or contains an invalid date.
ECUADOR_HOLIDAYS=
