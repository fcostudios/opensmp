# Ledger — Docker Compose runtime variables
# Copy to .env and replace every development-only value before deployment.
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
LEDGER_OWNER_PASSWORD=change-me-owner
LEDGER_APP_PASSWORD=change-me-app
LEDGER_BACKUP_PASSWORD=change-me-backup
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
NEXTAUTH_SECRET=change-me-with-a-long-random-value
